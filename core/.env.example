# API Keys and Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# 1. ElevenLabs API Key (for Speech-to-Text with Scribe)
# Get your key at: https://elevenlabs.io/app/speech-to-text
ELEVENLABS_API_KEY=

# 2. LLM API Key for Caption Grouping (OpenAI or Gemini)
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Or Gemini: https://aistudio.google.com/
GEMINI_API_KEY=

# Grouping settings
TARGET_WORDS_MIN=3
TARGET_WORDS_MAX=5
MAX_WORDS_TOLERANCE=7
MIN_WORDS_TOLERANCE=1
MAX_PAUSE_SECONDS=0.35
